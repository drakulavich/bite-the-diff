  "files": [{"sha":"c08bb081cf9e9079a151373061510d1c0a92ad37","filename":".github/workflows/record.yml","status":"added","additions":58,"deletions":0,"changes":58,"blob_url":"https://github.com/drakulavich/bite-the-diff/blob/43ecb03f2d3098b48d6147dcf4382221c8f8f78d/.github%2Fworkflows%2Frecord.yml","raw_url":"https://github.com/drakulavich/bite-the-diff/raw/43ecb03f2d3098b48d6147dcf4382221c8f8f78d/.github%2Fworkflows%2Frecord.yml","contents_url":"https://api.github.com/repos/drakulavich/bite-the-diff/contents/.github%2Fworkflows%2Frecord.yml?ref=43ecb03f2d3098b48d6147dcf4382221c8f8f78d","patch":"@@ -0,0 +1,58 @@\n+name: record\n+on:\n+  pull_request:\n+jobs:\n+  write:\n+    runs-on: ubuntu-latest\n+    permissions: { contents: read, pull-requests: write, checks: write }\n+    env:\n+      TOKEN: ${{ github.token }}\n+      PR: ${{ github.event.pull_request.number }}\n+      SHA: ${{ github.event.pull_request.head.sha }}\n+    steps:\n+      - run: |\n+          set -u\n+          mkdir out\n+          cp \"$GITHUB_EVENT_PATH\" out/event.json\n+          api() { # name method path [json]\n+            curl -sS -D \"out/$1.headers\" -o \"out/$1.json\" -X \"$2\" -w \"$1 %{http_code}\\n\" \\\n+              -H \"authorization: Bearer $TOKEN\" -H 'accept: application/vnd.github+json' \\\n+              -H 'x-github-api-version: 2022-11-28' ${4:+-d \"$4\"} \"$GITHUB_API_URL/repos/$GITHUB_REPOSITORY$3\"\n+          }\n+          api files GET \"/pulls/$PR/files?per_page=100&page=1\"\n+          api comments-empty GET \"/issues/$PR/comments?per_page=100&page=1\"\n+          api comment-create POST \"/issues/$PR/comments\" '{\"body\":\"<!-- bite-the-diff -->\\ncreated\"}'\n+          id=$(jq .id out/comment-create.json)\n+          api comment-update PATCH \"/issues/comments/$id\" '{\"body\":\"<!-- bite-the-diff -->\\nupdated\"}'\n+          api comments-one GET \"/issues/$PR/comments?per_page=100&page=1\"\n+          api checks-before GET \"/commits/$SHA/check-runs?per_page=100&page=1\"\n+          api check-create POST \"/check-runs\" \"{\\\"name\\\":\\\"bite-the-diff 🟡 1240 lines\\\",\\\"head_sha\\\":\\\"$SHA\\\",\\\"status\\\":\\\"completed\\\",\\\"conclusion\\\":\\\"neutral\\\",\\\"output\\\":{\\\"title\\\":\\\"1240 lines\\\",\\\"summary\\\":\\\"s\\\"}}\"\n+          cid=$(jq .id out/check-create.json)\n+          api check-update PATCH \"/check-runs/$cid\" '{\"name\":\"bite-the-diff 🔴 5200 lines\",\"status\":\"completed\",\"conclusion\":\"failure\",\"output\":{\"title\":\"5200 lines\",\"summary\":\"s\"}}'\n+          api checks-after GET \"/commits/$SHA/check-runs?per_page=100&page=1\"\n+          api check-back PATCH \"/check-runs/$cid\" '{\"name\":\"bite-the-diff 🟠 5200 lines\",\"status\":\"completed\",\"conclusion\":\"neutral\",\"output\":{\"title\":\"5200 lines\",\"summary\":\"s\"}}'\n+          echo ---; gh pr checks \"$PR\" -R \"$GITHUB_REPOSITORY\" || echo \"exit $?\"\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+      - uses: actions/upload-artifact@v7\n+        with: { name: write, path: out/ }\n+  read-only:\n+    runs-on: ubuntu-latest\n+    permissions: { contents: read, pull-requests: read, checks: read }\n+    env:\n+      TOKEN: ${{ github.token }}\n+      PR: ${{ github.event.pull_request.number }}\n+      SHA: ${{ github.event.pull_request.head.sha }}\n+    steps:\n+      - run: |\n+          mkdir out\n+          api() {\n+            curl -sS -D \"out/$1.headers\" -o \"out/$1.json\" -X \"$2\" -w \"$1 %{http_code}\\n\" \\\n+              -H \"authorization: Bearer $TOKEN\" -H 'accept: application/vnd.github+json' \\\n+              -H 'x-github-api-version: 2022-11-28' ${4:+-d \"$4\"} \"$GITHUB_API_URL/repos/$GITHUB_REPOSITORY$3\"\n+          }\n+          api comment-403 POST \"/issues/$PR/comments\" '{\"body\":\"x\"}'\n+          api check-403 POST \"/check-runs\" \"{\\\"name\\\":\\\"x\\\",\\\"head_sha\\\":\\\"$SHA\\\",\\\"status\\\":\\\"completed\\\",\\\"conclusion\\\":\\\"neutral\\\"}\"\n+          api check-list-readonly GET \"/commits/$SHA/check-runs?per_page=100&page=1\"\n+      - uses: actions/upload-artifact@v7\n+        with: { name: read-only, path: out/ }"},{"sha":"814f4a422927b82f5f8a43f8fab6d3839e3983f2","filename":"sample.txt","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/drakulavich/bite-the-diff/blob/43ecb03f2d3098b48d6147dcf4382221c8f8f78d/sample.txt","raw_url":"https://github.com/drakulavich/bite-the-diff/raw/43ecb03f2d3098b48d6147dcf4382221c8f8f78d/sample.txt","contents_url":"https://api.github.com/repos/drakulavich/bite-the-diff/contents/sample.txt?ref=43ecb03f2d3098b48d6147dcf4382221c8f8f78d","patch":"@@ -0,0 +1,2 @@\n+one\n+two"}],
